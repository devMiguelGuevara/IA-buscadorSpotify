# Copia este archivo como .env y rellena los valores.

# App de Spotify (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Carpeta de tu banco de audio (por defecto: ./musica)
# BANCO_AUDIO_DIR=D:\Musica\BancoAudio

# Solo si ffmpeg no está en el PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Proxy propio opcional (p. ej. el de tu VPN)
# BANCO_AUDIO_PROXY=socks5://127.0.0.1:1080
